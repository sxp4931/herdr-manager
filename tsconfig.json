{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@herdr/contracts": ["packages/contracts/src/index.ts"]
    }
  },
  "include": [
    "apps/server/src/**/*.ts",
