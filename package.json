{
  "name": "herdr-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only localhost dashboard for herdr, subscription quotas, and git work.",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:python": ".venv/bin/python -m unittest discover -s tests/python -v",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "build": "node scripts/build.mjs",
    "start": "node apps/server/dist/main.js",
    "check:policy": "node scripts/check-policy.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:python && npm run build && npm run test:integration"
  },
  "overrides": {
    "vitest": "4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.16.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
